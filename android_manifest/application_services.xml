<service
    android:name="org.drivercontrol.drivercontrol.UberOfferAccessibilityService"
    android:label="Driver Control - Lectura rápida de Uber"
    android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
    android:exported="true">
    <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
    </intent-filter>
    <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/uber_offer_accessibility_service" />
</service>

<service
    android:name="org.drivercontrol.drivercontrol.DriverOverlayService"
    android:exported="false"
    android:foregroundServiceType="specialUse">
    <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="User-started floating trip calculator and change calculator shown while another driving app is visible; no automatic interaction." />
</service>

<provider
    android:name="androidx.core.content.FileProvider"
    android:authorities="org.drivercontrol.drivercontrol.fileprovider"
    android:exported="false"
    android:grantUriPermissions="true">
    <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/driver_control_file_paths" />
</provider>

<service
    android:name="org.drivercontrol.drivercontrol.UberOfferAccessibilityService"
    android:label="Driver Control - Asistente de viajes"
    android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
    android:exported="true">
    <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
    </intent-filter>
    <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/uber_offer_accessibility_service" />
</service>

<service
    android:name="org.drivercontrol.drivercontrol.OcrCaptureService"
    android:exported="false"
    android:foregroundServiceType="mediaProjection" />
